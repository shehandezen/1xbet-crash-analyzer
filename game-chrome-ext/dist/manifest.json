{
  "manifest_version": 2,
  "name": "Automation Extension",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "devtools",
    "debugger"
  ],
  "background": {
    "service_worker": "background.js",
    "persistent": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/socket-inactive.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://*/*",
      "https://*/*"
    ]
  }
}